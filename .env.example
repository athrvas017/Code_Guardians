# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Google Safe Browsing API Key
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_API_KEY=your_google_api_key_here

# Hugging Face Space API
# URL of your deployed Space (e.g. https://<username>-<space-name>.hf.space/)
# You can find this URL in the "Embed this space" -> "Direct URL" section or just use the Space page URL
HF_API_URL=https://huggingface.co/spaces/your_username/ai-image-detector

# Your Hugging Face Token (Read access is fine if public, Write if private/gated)
HF_API_TOKEN=hf_your_token_here
